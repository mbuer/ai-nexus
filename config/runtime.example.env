# Safe example configuration only. Do not put secrets here.
AI_NEXUS_RUNTIME_ROOT="$HOME/ai-nexus-runtime"
POSTGRES_IMAGE_TAG="docker.io/pgvector/pgvector:pg17-trixie"
AI_NEXUS_BACKUP_DIR="$HOME/ai-nexus-runtime/backups/postgres"
AI_NEXUS_BACKUP_RETENTION_DAYS="14"

# Birdynator model routing
# Luna: low-cost extraction/classification and other simple tasks.
# Terra: default model for normal Birdynator analysis and conversation.
# Sol: explicit escalation path for difficult/deep analysis.
BIRDYNATOR_MODEL_FAST="gpt-5.6-luna"
BIRDYNATOR_MODEL_DEFAULT="gpt-5.6-terra"
BIRDYNATOR_MODEL_DEEP="gpt-5.6-sol"

# Environment-specific BirdNET datasource host. Override in config/runtime.local.env.
BIRDNET_SOURCE_HOST="BIRDNET_DB_HOST"
