[Unit]
Description=AI Nexus PostgreSQL 17 with pgvector

[Container]
Image=@@POSTGRES_IMAGE@@
ContainerName=ai-nexus-postgres
Network=ai-nexus-internal
Secret=postgres-superuser-password,type=mount,target=postgres-password,mode=0400
Environment=POSTGRES_USER=postgres
Environment=POSTGRES_DB=postgres
Environment=POSTGRES_PASSWORD_FILE=/run/secrets/postgres-password
Volume=ai-nexus-postgres-data:/var/lib/postgresql/data
PodmanArgs=--memory=2g --cpus=1.5 --pids-limit=512 --security-opt=no-new-privileges --ipc=private

[Service]
Restart=always
TimeoutStartSec=900

[Install]
WantedBy=default.target
