ARG BASE_IMAGE
FROM ${BASE_IMAGE}

ARG MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
ARG MODEL_REVISION=1110a243fdf4706b3f48f1d95db1a4f5529b4d41

ENV PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

RUN python - <<PY
from sentence_transformers import SentenceTransformer
model = SentenceTransformer("${MODEL_NAME}", revision="${MODEL_REVISION}")
model.save("/opt/model")
PY

COPY app.py .

RUN useradd --create-home --uid 10001 --shell /usr/sbin/nologin embedding \
    && chown -R embedding:embedding /app /opt/model

USER embedding

ENV EMBEDDING_MODEL_NAME=${MODEL_NAME} \
    EMBEDDING_MODEL_REVISION=${MODEL_REVISION} \
    EMBEDDING_MODEL_PATH=/opt/model \
    EMBEDDING_DIMENSIONS=384 \
    EMBEDDING_MAX_BATCH_SIZE=32 \
    HF_HUB_OFFLINE=1 \
    TRANSFORMERS_OFFLINE=1

EXPOSE 8000

CMD ["uvicorn", "app:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1", "--no-access-log"]
